name: "plant_model"
platform: "onnxruntime_onnx"

# The batch dimension is explicit in the ONNX graph ("batch_size"), so Triton's
# implicit batching is disabled and -1 is used for the first dimension instead.
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ -1, 3, 224, 224 ]   # RGB, ImageNet-normalised, NCHW
  }
]

output [
  {
    name: "output"              # raw class scores (logits) for the 38 classes
    data_type: TYPE_FP32
    dims: [ -1, 38 ]
  },
  {
    name: "features"            # last conv feature map, used to build heatmaps
    data_type: TYPE_FP32
    dims: [ -1, 1280, 7, 7 ]
  }
]

# Uses the GPU when one is visible to the container, otherwise falls back to CPU.
instance_group [
  {
    count: 1
    kind: KIND_AUTO
  }
]
