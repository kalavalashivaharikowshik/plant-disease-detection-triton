# Copy this file to `.env` and adjust values. Never commit `.env`.

# ---------- General ----------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Inference ----------
# auto   -> use Triton when it is reachable, otherwise the built-in ONNX Runtime
# onnx   -> always use the built-in ONNX Runtime (CPU)
# triton -> always use Triton (fails if Triton is down)
INFERENCE_BACKEND=auto
TRITON_URL=http://triton:8000
TRITON_MODEL_NAME=plant_model
MODEL_PATH=../model_repository/plant_model/1/model.onnx

# ---------- Reliability ----------
CONFIDENCE_THRESHOLD=0.70         # below this the UI shows a "retake photo" warning
STABILITY_VARIANTS=6              # 1-6 augmented copies used for the stability check

# ---------- AI explanations ----------
# auto -> gemini if GEMINI_API_KEY is set, else ollama if OLLAMA_URL is set, else built-in text
EXPLANATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b

# ---------- Cache ----------
# Leave empty to use the in-memory cache.
REDIS_URL=

# ---------- Security ----------
# When set, every /api request (except health) must send `X-API-Key: <value>`.
API_KEY=
RATE_LIMIT=30/minute
MAX_UPLOAD_MB=8
